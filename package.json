{
  "name": "video-notes",
  "main": "app.js",
  "productName": "Vide-note",
  "version": "1.0.0",
  "license": "MIT",
  "build": {
    "files": [
      "dist/**/*"
    ],
    "appId": "com.vide-note.app",
    "directories": {
      "output": "release",
      "buildResources": "dist"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "mergeASARs": false
    },
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150
        },
        {
          "x": 440,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "electronPackagerConfig": {
    "osxSign": {
      "identity": "4848JHR2S7"
    }
  },
  "config": {
    "forge": "forge.config.js"
  },
  "scripts": {
    "ng": "ng",
    "start": "electron-forge start",
    "start:electron": "ng build --configuration production && electron .",
    "build": "ng build",
    "build:develop": "ng build --configuration development",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "package": "electron-forge package",
    "remove-builds": "rm -rf dist && rm -rf out",
    "make:mac:m-series": "npm run remove-builds && ng build --configuration=production && electron-forge make  --config ./forge.config.js",
    "make:mac:intel": "electron-forge make --arch=x64",
    "dist": "build",
    "deploy": "rm -rf release && ng build && electron-builder  --universal",
    "deploy:gh-pages": "ng build && npx angular-cli-ghpages --dir=dist/video-notes",
    "check:circular-dependencies": "madge --circular src"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.2.0",
    "@angular/cdk": "^16.2.2",
    "@angular/common": "^16.2.0",
    "@angular/compiler": "^16.2.0",
    "@angular/core": "^16.2.0",
    "@angular/forms": "^16.2.0",
    "@angular/platform-browser": "^16.2.0",
    "@angular/platform-browser-dynamic": "^16.2.0",
    "@angular/router": "^16.2.0",
    "@videogular/ngx-videogular": "^8.0.0",
    "axios": "^1.7.9",
    "idb-keyval": "^6.2.1",
    "ngx-file-drop": "^16.0.0",
    "ngx-pagination": "^6.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.16",
    "@angular/cli": "~16.2.1",
    "@angular/compiler-cli": "^16.2.0",
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-deb": "^7.6.0",
    "@electron-forge/maker-rpm": "^7.6.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.6.0",
    "@electron/osx-sign": "^1.0.5",
    "@types/core-js": "^2.5.6",
    "@types/jasmine": "~4.3.0",
    "electron": "^33.2.1",
    "electron-forge": "^5.2.4",
    "electron-installer-dmg": "^4.0.0",
    "electron-packager": "^17.1.2",
    "electron-squirrel-startup": "^1.0.1",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.1.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  }
}